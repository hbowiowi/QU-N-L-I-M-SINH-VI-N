#1. Tao DataFrame
import pandas as pd

# Tạo dữ liệu mẫu cho 10 sinh viên
data = {
    'Họ và tên': [
        'Nguyễn Văn A', 'Trần Thị B', 'Lê Văn C', 'Phạm Thị D', 'Hoàng Văn E', 
        'Huỳnh Thị F', 'Phan Văn G', 'Vũ Thị H', 'Đặng Văn I', 'Bùi Thị K'
    ],
    'Điểm chuyên cần': [10, 9, 8, 10, 7, 9, 8, 10, 6, 9],
    'Điểm giữa kỳ': [8.5, 7.0, 6.5, 9.0, 5.5, 8.0, 7.5, 9.5, 5.0, 8.0],
    'Điểm cuối kỳ': [9.0, 8.0, 7.0, 8.5, 6.0, 8.5, 7.0, 9.0, 5.5, 8.5]
}

# Tạo DataFrame
df_students = pd.DataFrame(data)

# Hiển thị bảng dữ liệu
display(df_students)

# Yêu cầu 2: Tính điểm tổng kết
df_students['Tong_ket'] = 0.2 * df_students['Điểm chuyên cần'] + 0.3 * df_students['Điểm giữa kỳ'] + 0.5 * df_students['Điểm cuối kỳ']

# Yêu cầu 3: Xếp loại sinh viên
def phan_loai(diem):
    if diem >= 8.5:
        return 'Giỏi'
    elif diem >= 7.0:
        return 'Khá'
    elif diem >= 5.0:
        return 'Trung bình'
    else:
        return 'Yếu'

df_students['Xep_loai'] = df_students['Tong_ket'].apply(phan_loai)

# Hiển thị kết quả sau khi tính toán và xếp loại
display(df_students)

# Yêu cầu 4: Thống kê
diem_tb = df_students['Tong_ket'].mean()
sv_max = df_students.loc[df_students['Tong_ket'].idxmax()]
sv_min = df_students.loc[df_students['Tong_ket'].idxmin()]
sv_dat = df_students[df_students['Tong_ket'] >= 5.0].shape[0]

print(f"- Điểm tổng kết trung bình của lớp: {diem_tb:.2f}")
print(f"- Sinh viên có điểm tổng kết cao nhất: {sv_max['Họ và tên']} ({sv_max['Tong_ket']:.2f})")
print(f"- Sinh viên có điểm tổng kết thấp nhất: {sv_min['Họ và tên']} ({sv_min['Tong_ket']:.2f})")
print(f"- Số sinh viên đạt (điểm tổng kết >= 5): {sv_dat}/10")
import matplotlib.pyplot as plt

# Yêu cầu 5: Trực quan hóa dữ liệu
plt.figure(figsize=(12, 6))
plt.bar(df_students['Họ và tên'], df_students['Tong_ket'], color='skyblue', edgecolor='black')

plt.title('Biểu đồ điểm tổng kết của các sinh viên', fontsize=16, fontweight='bold')
plt.xlabel('Tên sinh viên', fontsize=12)
plt.ylabel('Điểm tổng kết', fontsize=12)
plt.ylim(0, 10)
plt.xticks(rotation=45)
plt.grid(axis='y', linestyle='--', alpha=0.7)

# Thêm giá trị số trên mỗi cột
for index, value in enumerate(df_students['Tong_ket']):
    plt.text(index, value + 0.1, f"{value:.1f}", ha='center', fontsize=10)

plt.tight_layout()
plt.show()
